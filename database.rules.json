{
  "rules": {
    "live": {
      "config": {
        ".read": "auth != null",
        ".write": "auth != null && auth.token.email === 'anfitrion@batalladekpis.com'"
      }
    },
    "rounds": {
      "$round": {
        ".read": "auth != null",
        ".write": "auth != null && auth.token.email === 'anfitrion@batalladekpis.com'",
        "teams": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && (root.child('live/config/round').val() === $round || (!root.child('live/config').exists() && $round === 'inicio'))",
            ".validate": "newData.hasChildren(['name', 'caseId', 'score', 'results', 'timeMs', 'joinedAt'])",
            "name": { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 28" },
            "caseId": { ".validate": "newData.isString() && newData.val().length <= 16" },
            "score": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 2250" },
            "correct": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 15" },
            "results": { ".validate": "newData.isString() && newData.val().length <= 15" },
            "timeMs": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "status": { ".validate": "newData.isString() && newData.val().length <= 8" },
            "tg": { ".validate": "newData.isString() && newData.val().length <= 15" },
            "bt": { ".validate": "newData.isString() && newData.val().length <= 15" },
            "el": { ".validate": "newData.isString() && newData.val().length <= 150" },
            "joinedAt": { ".validate": "newData.isNumber()" },
            "updatedAt": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        }
      }
    }
  }
}
